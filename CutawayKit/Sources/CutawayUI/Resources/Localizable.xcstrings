    "settings.projects.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Link a folder from an inspector or archive window. Cutaway only reads it: the sources, asset catalogs and string catalogs. It never writes into it or sends it anywhere."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在检查窗口或存档窗口里关联文件夹。Cutaway 只读取其中的源码、asset catalog 和 String Catalog，不写入，也不发送到别处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在檢查視窗或封存檔視窗中連結檔案夾。Cutaway 只會讀取其中的原始碼、asset catalog 和 String Catalog，不會寫入，也不會傳送到其他地方。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インスペクタまたはアーカイブのウインドウからフォルダをリンクします。Cutaway はソース、アセットカタログ、String Catalog を読み込むだけで、書き込んだりどこかへ送信したりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검사 또는 아카이브 윈도우에서 폴더를 연결합니다. Cutaway는 소스, 에셋 카탈로그, String Catalog를 읽기만 하며, 폴더에 쓰거나 다른 곳으로 보내지 않습니다."
          }
        }
      }
    },
