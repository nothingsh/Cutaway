    "app.incompatible.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speaks protocol %1$@; this Cutaway speaks %2$@. It cannot be inspected."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用协议 %1$@；此 Cutaway 使用 %2$@。无法检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用協定 %1$@；此 Cutaway 使用 %2$@。無法檢查。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロトコル %1$@ を使用しています。この Cutaway は %2$@ を使用しているため、検査できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로토콜 %1$@을(를) 사용합니다. 이 Cutaway는 %2$@을(를) 사용하므로 검사할 수 없습니다."
          }
        }
      }
    },
