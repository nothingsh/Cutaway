    "settings.language.explanation" : {
      "comment" : "Under the language pop-up.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System Default follows the language order in System Settings. Cutaway restarts to change its language."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“系统默认”按“系统设置”里的语言顺序选择。Cutaway 要重新启动才会改变语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「系統預設」依照「系統設定」中的語言順序選擇。Cutaway 需要重新啟動才會變更語言。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「システムのデフォルト」は「システム設定」の言語の優先順位に従います。言語を変更するには Cutaway を再起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘시스템 기본값’은 시스템 설정의 언어 순서를 따릅니다. 언어를 변경하려면 Cutaway를 다시 시작합니다."
          }
        }
      }
