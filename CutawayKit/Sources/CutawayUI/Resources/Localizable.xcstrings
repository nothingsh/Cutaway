    "settings.restart.message" : {
      "comment" : "The restart sheet's explanation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cutaway’s menus and windows change language when it opens again. Open inspections close; their apps can be inspected again after the restart."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cutaway 再次打开时，菜单和窗口会换成新的语言。打开的检查会关闭，重新启动后可以再次检查这些 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cutaway 再次開啟時，選單和視窗會換成新的語言。開啟中的檢查會關閉，重新啟動後可以再次檢查這些 App。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cutaway を次に開いたときに、メニューとウインドウが新しい言語になります。開いている検査は閉じます。再起動後にもう一度 App を検査できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cutaway를 다시 열면 메뉴와 윈도우가 새 언어로 바뀝니다. 열려 있는 검사는 닫히며, 다시 시작한 후 해당 앱을 다시 검사할 수 있습니다."
          }
        }
      }
    },
