    "appList.empty.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run an app that includes CutawayServer on a simulator, or on a device connected by USB. It shows up here by itself."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在模拟器或通过 USB 连接的设备上运行集成了 CutawayServer 的 App，它会自动出现在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在模擬器或透過 USB 連接的裝置上執行整合了 CutawayServer 的 App，它會自動出現在這裡。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CutawayServer を組み込んだ App をシミュレータ、または USB で接続したデバイスで実行してください。自動的にここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CutawayServer가 포함된 앱을 시뮬레이터나 USB로 연결된 기기에서 실행하십시오. 자동으로 여기에 나타납니다."
          }
        }
      }
    },
