    "settings.explanation" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These choose how a new inspection starts. Windows already open keep how they look; a reconnected inspection keeps its window's view."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些选项决定新的检查如何开始。已打开的窗口保持原样；重新连接的检查保持其窗口的视图。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些選項決定新的檢查如何開始。已打開的視窗保持原樣；重新連線的檢查保持其視窗的顯示方式。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらは新しい検査の開始時の表示を決めます。すでに開いているウインドウはそのままで、再接続した検査はウインドウの表示を保ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 설정은 새로운 검사가 시작되는 방식을 결정합니다. 이미 열려 있는 윈도우는 그대로 유지되며, 다시 연결된 검사는 해당 윈도우의 보기를 유지합니다."
          }
        }
      }
    },
