    "appList.empty.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run an app that includes CutawayServer in a simulator or on a connected device. It appears here within a few seconds."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在模拟器或已连接的设备上运行集成了 CutawayServer 的 App，几秒钟内它就会出现在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在模擬器或已連接的裝置上執行整合了 CutawayServer 的 App，幾秒內它就會出現在這裡。"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CutawayServer を組み込んだ App をシミュレータまたは接続したデバイスで実行してください。数秒以内にここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CutawayServer가 포함된 앱을 시뮬레이터나 연결된 기기에서 실행하십시오. 몇 초 안에 여기에 나타납니다."
          }
        }
      }
    },
